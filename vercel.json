{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "env": {
    "PYTHONPATH": "."
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/setup-forwarding",
      "destination": "/setup-forwarding.html"
    },
    {
      "source": "/internal/review",
      "destination": "/internal/review.html"
    },
    {
      "source": "/portal",
      "destination": "/portal.html"
    },
    {
      "source": "/onboarding",
      "destination": "/onboarding.html"
    }
  ]
}
