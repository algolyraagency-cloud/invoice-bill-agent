{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/main.py"
    },
    {
      "source": "/api",
      "destination": "/main.py"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/setup-forwarding",
      "destination": "/setup-forwarding.html"
    },
    {
      "source": "/internal/review",
      "destination": "/internal/review.html"
    },
    {
      "source": "/portal",
      "destination": "/portal.html"
    },
    {
      "source": "/onboarding",
      "destination": "/onboarding.html"
    }
  ]
}
